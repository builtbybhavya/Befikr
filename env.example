# NIRIKSHAK — Environment Configuration
# National Capital Territory of Delhi Crime Intelligence & Route Risk Platform

# Application Environment (development, staging, production)
APP_ENV=development

# Demo Mode: set to true to seed and display synthetic sample records when live feeds are unavailable
DEMO_MODE=true

# Database Connection
# SQLite fallback (default local development):
DATABASE_URL=sqlite:///./nirikshak.db
# PostgreSQL / PostGIS (production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nirikshak_db

# Google Maps Platform Credentials (Optional - OpenStreetMap & OSRM are used if not provided)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_STREET_VIEW_API_KEY=

# LLM Provider Configuration for Structured Incident Extraction (Optional - Local NLP / heuristic extractor used if blank)
# Supported options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Routing Service URL (Default: Public OSRM API or Local Hub Router)
OSRM_ROUTER_URL=https://router.project-osrm.org

# Scoring Engine Weights (must sum to 1.0)
WEIGHT_CRIME_EXPOSURE=0.40
WEIGHT_INCIDENT_RECENCY=0.20
WEIGHT_CONTEXTUAL_INFRASTRUCTURE=0.15
WEIGHT_TIME_OF_DAY=0.15
WEIGHT_DATA_UNCERTAINTY=0.10

# Geofence & Spatial Thresholds
SEGMENT_LENGTH_METERS=150
INCIDENT_BUFFER_RADIUS_METERS=250
RECENCY_HALF_LIFE_DAYS=180

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
